# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────
# X (Twitter) Filtered Stream  [requires Basic plan ~$100/mo]
# Get token: developer.twitter.com
# ─────────────────────────────────────────────────────
X_BEARER_TOKEN=""

# ─────────────────────────────────────────────────────
# Reddit API  [100% FREE — script app]
# Steps:
#   1. Go to https://www.reddit.com/prefs/apps
#   2. Click "Create App" → Type: "script"
#   3. Copy the client_id (under app name) and secret
#   4. Paste below into your LOCAL .env (not this file!)
#   5. Run: python connectors/start_reddit_connector.py
# SECURITY: Never commit a real secret. .env is gitignored.
# ─────────────────────────────────────────────────────
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# Optional — defaults to SentinelAI:threat-monitor:v1.0
REDDIT_USER_AGENT=""
